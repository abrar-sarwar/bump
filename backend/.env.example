# Copy to .env and fill in. Never commit .env.
XAI_API_KEY=xai-your-key-here
XAI_MODEL=grok-4.3

# Optional
# XAI_REASONING_EFFORT=none   # none|low|medium|high; empty = model default
# XAI_STT_MODEL=grok-voice-transcribe-2.0
# Spoken onboarding (realtime speech to speech)
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_VOICE=eve
# PORT=8787
# HOST=0.0.0.0
